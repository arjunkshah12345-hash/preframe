{
  "name": "preframe",
  "private": true,
  "version": "0.1.0",
  "description": "Adaptive cooperative scheduling for JavaScript — work hard without freezing the page",
  "homepage": "https://github.com/arjunkshah12345-hash/preframe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arjunkshah12345-hash/preframe.git"
  },
  "bugs": {
    "url": "https://github.com/arjunkshah12345-hash/preframe/issues"
  },
  "keywords": [
    "scheduling",
    "cooperative",
    "main-thread",
    "yield",
    "aimd",
    "ewma",
    "performance",
    "responsiveness"
  ],
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "pnpm --filter @preframe/demo dev",
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @preframe/demo build",
    "test": "pnpm --filter @preframe/core test",
    "benchmark": "pnpm --filter @preframe/benchmark start",
    "verify:demo": "pnpm --filter @preframe/demo exec node scripts/verify-demo.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
